<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/electric_blue_pressed" />
            <stroke android:width="1.5dp" android:color="@color/cyan_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/btn_reset_bg" />
            <stroke android:width="1.5dp" android:color="@color/electric_blue" />
        </shape>
    </item>
</selector>
